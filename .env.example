# docker compose reads these from .env. The defaults already match, so copying this file is optional.
POSTGRES_USER=educonnect
POSTGRES_PASSWORD=educonnect
POSTGRES_DB=educonnect
# Host ports, published on 127.0.0.1 only (non-default so a local PostgreSQL or Redis does not clash).
WEB_PORT=3000
API_PORT=8000
DB_PORT=15432
REDIS_PORT=16379
# LLM: auto (Azure when the values below are set, otherwise fallback paths), azure, fake (tests), none.
LLM_PROVIDER=
# 1 only for E2E/CI: adds /api/test/* (seed reset, clock, LLM double).
ENABLE_TEST_ROUTES=
# Seed account password (names only here; keep the value in your own .env).
SEED_PASSWORD=
# Azure OpenAI: names only. Keep the values outside the repository and pass the file with --env-file.
AZURE_OPENAI_LOCATION=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
